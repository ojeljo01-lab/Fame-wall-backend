# ════════════════════════════════════════════
# THE FAME WALL — Backend configuration
# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git.
# ════════════════════════════════════════════

# Server
PORT=3001
SITE_URL=http://localhost:8080
# In production, set SITE_URL to your real domain, e.g. https://thefamewall.com

# Resend (email sending) — get a free key at https://resend.com
# Free tier: 100 emails/day, 3,000/month, no credit card required.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address emails are sent from.
# IMPORTANT: until you verify your own domain on Resend, you must use
# "onboarding@resend.dev" — Resend's shared sending domain for testing.
# Once you verify your domain (Resend dashboard → Domains), switch to
# something like "The Fame Wall <noreply@yourdomain.com>"
FROM_EMAIL="The Fame Wall <onboarding@resend.dev>"

# JWT secret used to sign session tokens — generate a long random string
# e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a verification code stays valid (minutes)
CODE_EXPIRY_MINUTES=15
